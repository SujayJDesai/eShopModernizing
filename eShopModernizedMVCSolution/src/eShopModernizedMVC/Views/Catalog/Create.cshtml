@model eShopModernizedMVC.Models.CatalogItem

@{
    ViewBag.Title = "Create";
}

<h2 class="esh-body-title">Create</h2>


<form asp-action="Create" method="post" asp-antiforgery="true">
    <div class="container">

    <div class="row">
        <div class="col-md-4">
            <div class="row"><img class="esh-picture" src="@Model.PictureUri" /></div>

            @if (ViewBag.UseAzureStorage)
            {
                <div class="row">
                    <div class="col-md-6">
                        <label class="btn btn-default esh-button-upload">
                            Upload image <input type="file" id="uploadEditorImage" accept="image/*" class="hidden" />
                        </label>
                        <input type="hidden" asp-for="TempImageName" />
                    </div>

                    <div class="esh-loader col-md-3 hidden"></div>
                    <div class="col-md-6">
                        <span class="text-danger field-validation-error" id="img-validation-error"></span>
                    </div>
                </div>
            }
        </div>


        <div class="col-md-8 form-horizontal">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label col-md-2"></label>
                <div class="col-md-8">
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label col-md-2"></label>
                <div class="col-md-8">
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="CatalogBrandId" class="control-label col-md-2"></label>
                <div class="col-md-8">
                    <select asp-for="CatalogBrandId" asp-items="@(ViewBag.CatalogBrandId as SelectList)" class="form-control"></select>
                    <span asp-validation-for="CatalogBrandId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="CatalogTypeId" class="control-label col-md-2"></label>
                <div class="col-md-8">
                    <select asp-for="CatalogTypeId" asp-items="@(ViewBag.CatalogTypeId as SelectList)" class="form-control"></select>
                    <span asp-validation-for="CatalogTypeId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Price" class="control-label col-md-2"></label>
                <div class="col-md-8">
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="AvailableStock" class="control-label col-md-2"></label>
                <div class="col-md-8">
                    <input asp-for="AvailableStock" class="form-control" />
                    <span asp-validation-for="AvailableStock" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="RestockThreshold" class="control-label col-md-2"></label>
                <div class="col-md-8">
                    <input asp-for="RestockThreshold" class="form-control" />
                    <span asp-validation-for="RestockThreshold" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="MaxStockThreshold" class="control-label col-md-2"></label>
                <div class="col-md-8">
                    <input asp-for="MaxStockThreshold" class="form-control" />
                    <span asp-validation-for="MaxStockThreshold" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-8 text-right esh-button-actions">
                    <a asp-action="Index" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                    <input type="submit" value="[ Create ]" class="btn esh-button esh-button-primary" />
                </div>
            </div>
        </div>


    </div>


    </div>
    
</form>

<div>
    
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
