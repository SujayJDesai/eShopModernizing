<!--
  PORT-TODO
  {"note": "ApplicationInsights.config is obsolete in ASP.NET Core. All telemetry configuration (telemetry initializers, telemetry modules, telemetry processors, adaptive sampling, dependency tracking, performance counters, Live Metrics) is now handled by builder.Services.AddApplicationInsightsTelemetry() in Program.cs. Custom settings previously in this file (e.g. MaxTelemetryItemsPerSecond, ExcludedTypes, IncludedTypes for adaptive sampling) should be configured via ApplicationInsightsServiceOptions or TelemetryConfiguration in Program.cs. This file can be safely deleted once Program.cs AI setup is confirmed.", "was": "ApplicationInsights.config (Microsoft.AI.Web / Microsoft.AI.DependencyCollector / Microsoft.AI.PerfCounterCollector / Microsoft.AI.ServerTelemetryChannel / Microsoft.AI.WindowsServer)", "files": ["Program.cs"]}
-->
<!--
  Legacy ApplicationInsights.config — OBSOLETE on ASP.NET Core.

  The following telemetry components were configured here and are now
  handled automatically by the Microsoft.ApplicationInsights.AspNetCore
  NuGet package (3.2.0) when AddApplicationInsightsTelemetry() is called
  in Program.cs:

  Telemetry Initializers (auto-registered by the ASP.NET Core SDK):
    - HttpDependenciesParsingTelemetryInitializer
    - AzureRoleEnvironmentTelemetryInitializer
    - AzureWebAppRoleEnvironmentTelemetryInitializer
    - BuildInfoConfigComponentVersionTelemetryInitializer
    - WebTestTelemetryInitializer / SyntheticUserAgentTelemetryInitializer
    - ClientIpHeaderTelemetryInitializer
    - OperationNameTelemetryInitializer / OperationCorrelationTelemetryInitializer
    - UserTelemetryInitializer / AuthenticatedUserIdTelemetryInitializer
    - AccountIdTelemetryInitializer / SessionTelemetryInitializer

  Telemetry Modules (auto-registered):
    - DependencyTrackingTelemetryModule
    - PerformanceCollectorModule
    - QuickPulseTelemetryModule (Live Metrics)
    - AppServicesHeartbeatTelemetryModule
    - AzureInstanceMetadataTelemetryModule
    - DeveloperModeWithDebuggerAttachedTelemetryModule
    - UnhandledExceptionTelemetryModule / UnobservedExceptionTelemetryModule
    - RequestTrackingTelemetryModule / ExceptionTrackingTelemetryModule
    - AspNetDiagnosticTelemetryModule

  Telemetry Processors / Channel:
    - QuickPulseTelemetryProcessor
    - AutocollectedMetricsExtractor
    - AdaptiveSamplingTelemetryProcessor (MaxTelemetryItemsPerSecond=5)
    - ServerTelemetryChannel

  To customise adaptive sampling in Program.cs:

    builder.Services.AddApplicationInsightsTelemetry();
    builder.Services.Configure<TelemetryConfiguration>(config =>
    {
        var builder = config.DefaultTelemetrySink.TelemetryProcessorChainBuilder;
        builder.UseAdaptiveSampling(maxTelemetryItemsPerSecond: 5,
            excludedTypes: "Event");
        builder.Build();
    });

  This file should be deleted once the Program.cs configuration is confirmed working.
-->
<ApplicationInsights xmlns="http://schemas.microsoft.com/ApplicationInsights/2013/Settings">
</ApplicationInsights>
