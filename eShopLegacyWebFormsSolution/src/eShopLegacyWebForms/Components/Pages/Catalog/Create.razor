@page "/Catalog/Create"
@rendermode InteractiveServer
@using eShopLegacyWebForms.Models
@using eShopLegacyWebForms.Services
@inject ICatalogService CatalogService
@inject ILogger<Create> Logger
@inject NavigationManager Navigation

<PageTitle>Create</PageTitle>

<h2 class="esh-body-title">Create</h2>

<div>
    <EditForm Model="catalogItem" FormName="createCatalogItem" OnValidSubmit="CreateClick">
        <DataAnnotationsValidator />
        <div class="form-horizontal">
            <div class="form-group">
                <label class="control-label col-md-2">Name</label>
                <div class="col-md-3">
                    <InputText id="Name" @bind-Value="catalogItem.Name" class="form-control" />
                    <ValidationMessage For="@(() => catalogItem.Name)" />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Description</label>
                <div class="col-md-3">
                    <InputText id="Description" @bind-Value="catalogItem.Description" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Brand</label>
                <div class="col-md-3">
                    <select id="Brand" value="@catalogItem.CatalogBrandId" @onchange="OnBrandChanged" class="form-control">
                        @if (brands != null)
                        {
                            @foreach (var brand in brands)
                            {
                                <option value="@brand.Id">@brand.Brand</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Type</label>
                <div class="col-md-3">
                    <select id="Type" value="@catalogItem.CatalogTypeId" @onchange="OnTypeChanged" class="form-control">
                        @if (types != null)
                        {
                            @foreach (var type in types)
                            {
                                <option value="@type.Id">@type.Type</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Price</label>
                <div class="col-md-3">
                    <InputNumber id="Price" @bind-Value="catalogItem.Price" class="form-control" />
                    <ValidationMessage For="@(() => catalogItem.Price)" />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Picture name</label>
                <div class="col-md-4 esh-form-information">
                    Uploading images not allowed for this version.
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Stock</label>
                <div class="col-md-3">
                    <InputNumber id="Stock" @bind-Value="catalogItem.AvailableStock" class="form-control" />
                    <ValidationMessage For="@(() => catalogItem.AvailableStock)" />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Restock</label>
                <div class="col-md-3">
                    <InputNumber id="Restock" @bind-Value="catalogItem.RestockThreshold" class="form-control" />
                    <ValidationMessage For="@(() => catalogItem.RestockThreshold)" />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">Max stock</label>
                <div class="col-md-3">
                    <InputNumber id="Maxstock" @bind-Value="catalogItem.MaxStockThreshold" class="form-control" />
                    <ValidationMessage For="@(() => catalogItem.MaxStockThreshold)" />
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-3 text-right esh-button-actions">
                    <a href="/" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                    <button type="submit" class="btn esh-button esh-button-primary">[ Create ]</button>
                </div>
            </div>
        </div>
    </EditForm>
</div>

@code {
    private CatalogItem catalogItem = new();
    private IEnumerable<CatalogBrand>? brands;
    private IEnumerable<CatalogType>? types;

    protected override void OnInitialized()
    {
        Logger.LogInformation("Now loading... /Catalog/Create");
        brands = CatalogService.GetCatalogBrands();
        types = CatalogService.GetCatalogTypes();

        // Set default brand/type to first available
        var firstBrand = brands?.FirstOrDefault();
        if (firstBrand != null)
        {
            catalogItem.CatalogBrandId = firstBrand.Id;
        }

        var firstType = types?.FirstOrDefault();
        if (firstType != null)
        {
            catalogItem.CatalogTypeId = firstType.Id;
        }
    }

    private void OnBrandChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var brandId))
        {
            catalogItem.CatalogBrandId = brandId;
        }
    }

    private void OnTypeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var typeId))
        {
            catalogItem.CatalogTypeId = typeId;
        }
    }

    private void CreateClick()
    {
        CatalogService.CreateCatalogItem(catalogItem);
        Navigation.NavigateTo("/");
    }
}
