@page "/"
@page "/Default"
@page "/Default/index/{Index:int}/size/{Size:int}"
@rendermode InteractiveServer

@using eShopLegacyWebForms.Models
@using eShopLegacyWebForms.Services
@using eShopLegacyWebForms.ViewModel

@inject ICatalogService CatalogService
@inject ILogger<Default> Logger

<PageTitle>Home Page</PageTitle>

<div class="esh-table">
    <p class="esh-link-wrapper">
        <a href="/Catalog/Create" class="btn esh-button esh-button-primary">
            Create New
        </a>
    </p>

    @if (Model != null && Model.Data != null && Model.Data.Any())
    {
        <table class="table">
            <thead>
                <tr class="esh-table-header">
                    <th></th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Brand</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Picture name</th>
                    <th>Stock</th>
                    <th>Restock</th>
                    <th>Max stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Data)
                {
                    <tr>
                        <td>
                            <image class="esh-thumbnail" src="/Pics/@item.PictureFileName" />
                        </td>
                        <td>
                            <p>@item.Name</p>
                        </td>
                        <td>
                            <p>@item.Description</p>
                        </td>
                        <td>
                            <p>@item.CatalogBrand.Brand</p>
                        </td>
                        <td>
                            <p>@item.CatalogType.Type</p>
                        </td>
                        <td>
                            <p>
                                <span class="esh-price">@item.Price</span>
                            </p>
                        </td>
                        <td>
                            <p>@item.PictureFileName</p>
                        </td>
                        <td>
                            <p>@item.AvailableStock</p>
                        </td>
                        <td>
                            <p>@item.RestockThreshold</p>
                        </td>
                        <td>
                            <p>@item.MaxStockThreshold</p>
                        </td>
                        <td>
                            <a href="@($"/Catalog/Edit/{item.Id}")" class="esh-table-link">
                                Edit
                            </a>
                            |
                            <a href="@($"/Catalog/Details/{item.Id}")" class="esh-table-link">
                                Details
                            </a>
                            |
                            <a href="@($"/Catalog/Delete/{item.Id}")" class="esh-table-link">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <table>
            <tr>
                <td>No data was returned.</td>
            </tr>
        </table>
    }
</div>

<div class="esh-pager">
    <div class="container">
        <article class="esh-pager-wrapper row">
            <nav>
                <a href="@PaginationPreviousUrl" class="@PaginationPreviousCssClass">
                    Previous
                </a>

                <span class="esh-pager-item">
                    Showing @Model?.ItemsPerPage of @Model?.TotalItems products - Page @((Model?.ActualPage ?? 0) + 1) - @Model?.TotalPages
                </span>

                <a href="@PaginationNextUrl" class="@PaginationNextCssClass">
                    Next
                </a>
            </nav>
        </article>
    </div>
</div>

@code {
    public const int DefaultPageIndex = 0;
    public const int DefaultPageSize = 10;

    [Parameter]
    public int? Index { get; set; }

    [Parameter]
    public int? Size { get; set; }

    private PaginatedItemsViewModel<CatalogItem>? Model { get; set; }

    private string PaginationNextUrl { get; set; } = string.Empty;
    private string PaginationNextCssClass { get; set; } = "esh-pager-item esh-pager-item--navigable";
    private string PaginationPreviousUrl { get; set; } = string.Empty;
    private string PaginationPreviousCssClass { get; set; } = "esh-pager-item esh-pager-item--navigable";

    protected override void OnInitialized()
    {
        int size;
        int index;

        if (Size.HasValue && Index.HasValue)
        {
            size = Size.Value;
            index = Index.Value;
            Model = CatalogService.GetCatalogItemsPaginated(size, index);
            Logger.LogInformation("Now loading... /Default?size={Size}&index={Index}", size, index);
        }
        else
        {
            size = DefaultPageSize;
            index = DefaultPageIndex;
            Model = CatalogService.GetCatalogItemsPaginated(DefaultPageSize, DefaultPageIndex);
            Logger.LogInformation("Now loading... /Default?size={Size}&index={Index}", DefaultPageSize, DefaultPageIndex);
        }

        ConfigurePagination();
    }

    private void ConfigurePagination()
    {
        if (Model == null)
        {
            return;
        }

        PaginationNextUrl = $"/Default/index/{Model.ActualPage + 1}/size/{Model.ItemsPerPage}";
        PaginationNextCssClass = Model.ActualPage < Model.TotalPages - 1
            ? "esh-pager-item esh-pager-item--navigable"
            : "esh-pager-item esh-pager-item--navigable esh-pager-item--hidden";

        PaginationPreviousUrl = $"/Default/index/{Model.ActualPage - 1}/size/{Model.ItemsPerPage}";
        PaginationPreviousCssClass = Model.ActualPage > 0
            ? "esh-pager-item esh-pager-item--navigable"
            : "esh-pager-item esh-pager-item--navigable esh-pager-item--hidden";
    }
}
