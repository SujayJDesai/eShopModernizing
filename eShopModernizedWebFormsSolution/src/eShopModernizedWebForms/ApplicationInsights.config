<!--
  PORT-TODO
  {"note": "ApplicationInsights.config is not used by the ASP.NET Core Application Insights SDK (Microsoft.ApplicationInsights.AspNetCore). All telemetry initializers, modules, processors, and channels that were configured here are auto-registered by builder.Services.AddApplicationInsightsTelemetry() in Program.cs. Set the connection string in appsettings.json under ApplicationInsights:ConnectionString (or the legacy InstrumentationKey under ApplicationInsights:InstrumentationKey). Adaptive sampling, QuickPulse (Live Metrics), dependency tracking, request tracking, and exception tracking are all enabled by default. This file can be deleted once Program.cs wires up AddApplicationInsightsTelemetry().", "files": ["Program.cs", "appsettings.json"]}
-->
<!--
  This file is a legacy artifact from the ASP.NET Framework Application Insights SDK.
  ASP.NET Core uses code-based configuration instead:

  In Program.cs:
    builder.Services.AddApplicationInsightsTelemetry();

  In appsettings.json:
    "ApplicationInsights": {
      "ConnectionString": "InstrumentationKey=your-key-here;IngestionEndpoint=https://..."
    }

  The following features from the original config are handled automatically
  by the ASP.NET Core SDK and do not require manual configuration:

  - TelemetryInitializers: HttpDependenciesParsingTelemetryInitializer,
    AzureRoleEnvironmentTelemetryInitializer, AzureWebAppRoleEnvironmentTelemetryInitializer,
    BuildInfoConfigComponentVersionTelemetryInitializer, WebTestTelemetryInitializer,
    SyntheticUserAgentTelemetryInitializer, ClientIpHeaderTelemetryInitializer,
    OperationNameTelemetryInitializer, OperationCorrelationTelemetryInitializer,
    UserTelemetryInitializer, AuthenticatedUserIdTelemetryInitializer,
    AccountIdTelemetryInitializer, SessionTelemetryInitializer

  - TelemetryModules: DependencyTrackingTelemetryModule, PerformanceCollectorModule,
    QuickPulseTelemetryModule, AppServicesHeartbeatTelemetryModule,
    AzureInstanceMetadataTelemetryModule, DeveloperModeWithDebuggerAttachedTelemetryModule,
    UnhandledExceptionTelemetryModule, UnobservedExceptionTelemetryModule,
    RequestTrackingTelemetryModule, ExceptionTrackingTelemetryModule,
    AspNetDiagnosticTelemetryModule

  - TelemetryProcessors: QuickPulseTelemetryProcessor,
    AutocollectedMetricsExtractor, AdaptiveSamplingTelemetryProcessor

  - TelemetryChannel: ServerTelemetryChannel

  To customize sampling, add options in Program.cs:
    builder.Services.AddApplicationInsightsTelemetry(options =>
    {
        options.EnableAdaptiveSampling = true;
    });

    builder.Services.Configure<TelemetryConfiguration>(config =>
    {
        var builder = config.DefaultTelemetrySink.TelemetryProcessorChainBuilder;
        builder.UseAdaptiveSampling(maxTelemetryItemsPerSecond: 5,
            excludedTypes: "Event");
        builder.Build();
    });
-->
<ApplicationInsights xmlns="http://schemas.microsoft.com/ApplicationInsights/2013/Settings">
  <!-- This file is intentionally empty. Application Insights is now configured in Program.cs. -->
</ApplicationInsights>
