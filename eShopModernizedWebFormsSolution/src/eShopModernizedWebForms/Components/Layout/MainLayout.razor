@inherits LayoutComponentBase
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<header class="navbar navbar-light navbar-static-top">
    <div class="esh-header-brand">
        <a href="/">
            <img src="/images/brand.png" alt="eShop brand" />
        </a>
        @if (_useAzureActiveDirectory)
        {
            <AuthorizeView>
                <NotAuthorized>
                    <ul class="nav navbar-nav navbar-right">
                        <li>
                            <a class="esh-login-link" href="MicrosoftIdentity/Account/SignIn">Sign in</a>
                        </li>
                    </ul>
                </NotAuthorized>
                <Authorized>
                    <ul class="nav navbar-nav navbar-right">
                        <li class="navbar-text">Hello, @context.User.Identity?.Name !</li>
                        <li>
                            <a class="esh-login-link" href="MicrosoftIdentity/Account/SignOut">Sign out</a>
                        </li>
                    </ul>
                </Authorized>
            </AuthorizeView>
        }
    </div>
</header>

<section class="esh-app-hero">
    <div class="container esh-header">
        <h1 class="esh-header-title">Catalog Manager <span>(Blazor)</span></h1>
    </div>
</section>

<div>
    @Body
</div>

<footer class="esh-app-footer">
    <div class="container">
        <article class="row">
            <section class="col-sm-6">
                <img class="esh-app-footer-brand" src="/images/brand_dark.png" alt="eShop brand" />
            </section>
            <section class="col-sm-6">
                <img class="esh-app-footer-text hidden-xs" src="/images/main_footer_text.png" width="335" height="26" alt="footer text image" />
                <br />
                @* PORT-TODO *@
                @* {"was": "System.Web.HttpContext.Current.Session", "note": "Session-based machine name and start time display (SessionInfoLabel) needs a replacement — consider using IHttpContextAccessor or a custom service to capture machine name and session start time, then inject it here.", "files": ["Program.cs"]} *@
                <small style="color:white">@_sessionInfo</small>
            </section>
        </article>
    </div>
</footer>

@code {
    private bool _useAzureActiveDirectory;
    private string _sessionInfo = string.Empty;

    protected override void OnInitialized()
    {
        _useAzureActiveDirectory = bool.TryParse(Configuration["UseAzureActiveDirectory"], out var result) && result;

        // PORT-TODO
        // {"was": "System.Web.HttpContext.Current.Session", "note": "Legacy code read Session['MachineName'] and Session['SessionStartTime'] set in Global.asax Session_Start. Replace with an injected service or IHttpContextAccessor-based approach once Program.cs session middleware is wired up.", "files": ["Program.cs"]}
        _sessionInfo = $"{Environment.MachineName}";
    }
}
