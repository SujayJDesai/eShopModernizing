@page "/Catalog/Edit/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@using eShopModernizedWebForms.Models
@using eShopModernizedWebForms.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Configuration
@inject ICatalogService CatalogService
@inject IImageService ImageService
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Edit</PageTitle>

<h2 class="esh-body-title">Edit</h2>

<div class="container">
    <div class="row">
        @if (product != null)
        {
            <div class="col-md-4">
                <img class="esh-picture" src="@($"/Pics/{product.PictureFileName}")" alt="@product.Name" />

                @if (useAzureStorage)
                {
                    <div id="UploadButton" class="row">
                        <div class="col-md-6">
                            <label class="btn btn-default esh-button-upload">
                                Upload image
                                <input type="file" id="uploadEditorImage" accept="image/*" class="hidden" />
                            </label>
                            <input type="hidden" id="TempImageName" @bind="tempImageName" />
                        </div>

                        <div class="esh-loader col-md-3 hidden"></div>
                        <div class="col-md-6">
                            <span class="text-danger field-validation-error" id="img-validation-error"></span>
                        </div>
                    </div>
                }
            </div>
            <div class="col-md-8 form-horizontal">
                <EditForm Model="product" FormName="editCatalogItem" OnValidSubmit="SaveClick">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label class="control-label col-md-4">Name</label>
                        <div class="col-md-8">
                            <InputText id="Name" class="form-control" @bind-Value="product.Name" />
                            <ValidationMessage For="@(() => product.Name)" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-4">Description</label>
                        <div class="col-md-8">
                            <InputText id="Description" class="form-control" @bind-Value="product.Description" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-4">Brand</label>
                        <div class="col-md-8">
                            <select id="BrandDropDownList" class="form-control" value="@product.CatalogBrandId" @onchange="OnBrandChanged">
                                @if (brands != null)
                                {
                                    @foreach (var brand in brands)
                                    {
                                        <option value="@brand.Id">@brand.Brand</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-4">Type</label>
                        <div class="col-md-8">
                            <select id="TypeDropDownList" class="form-control" value="@product.CatalogTypeId" @onchange="OnTypeChanged">
                                @if (types != null)
                                {
                                    @foreach (var catalogType in types)
                                    {
                                        <option value="@catalogType.Id">@catalogType.Type</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-4">Price</label>
                        <div class="col-md-8">
                            <InputNumber id="Price" class="form-control" @bind-Value="product.Price" />
                            <ValidationMessage For="@(() => product.Price)" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-4">Picture name</label>
                        <div class="col-md-8">
                            <input id="PictureFileName" type="text" class="form-control" readonly
                                   title="Not allowed for edition" value="@product.PictureFileName" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-4">Stock</label>
                        <div class="col-md-8">
                            <InputNumber id="Stock" class="form-control" @bind-Value="product.AvailableStock" />
                            <ValidationMessage For="@(() => product.AvailableStock)" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-4">Restock</label>
                        <div class="col-md-8">
                            <InputNumber id="Restock" class="form-control" @bind-Value="product.RestockThreshold" />
                            <ValidationMessage For="@(() => product.RestockThreshold)" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-4">Max stock</label>
                        <div class="col-md-8">
                            <InputNumber id="Maxstock" class="form-control" @bind-Value="product.MaxStockThreshold" />
                            <ValidationMessage For="@(() => product.MaxStockThreshold)" />
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-12 text-right esh-button-actions">
                            <a href="/" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                            <button type="submit" class="btn esh-button esh-button-primary">[ Save ]</button>
                        </div>
                    </div>
                </EditForm>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [Inject] private ILogger<Edit> Logger { get; set; } = default!;

    private CatalogItem? product;
    private IEnumerable<CatalogBrand>? brands;
    private IEnumerable<CatalogType>? types;
    private string tempImageName = string.Empty;
    private bool useAzureStorage;

    protected override void OnInitialized()
    {
        Logger.LogInformation("Now loading... /Catalog/Edit");

        useAzureStorage = bool.TryParse(Configuration["UseAzureStorage"], out var val) && val;

        product = CatalogService.FindCatalogItem(Id);
        brands = CatalogService.GetCatalogBrands();
        types = CatalogService.GetCatalogTypes();
    }

    private void OnBrandChanged(ChangeEventArgs e)
    {
        if (product != null && int.TryParse(e.Value?.ToString(), out var brandId))
        {
            product.CatalogBrandId = brandId;
        }
    }

    private void OnTypeChanged(ChangeEventArgs e)
    {
        if (product != null && int.TryParse(e.Value?.ToString(), out var typeId))
        {
            product.CatalogTypeId = typeId;
        }
    }

    private void SaveClick()
    {
        if (product == null)
        {
            return;
        }

        product.TempImageName = tempImageName;

        if (!string.IsNullOrEmpty(product.TempImageName))
        {
            ImageService.UpdateImage(product);
            var fileName = Path.GetFileName(product.TempImageName);
            product.PictureFileName = fileName;
        }

        CatalogService.UpdateCatalogItem(product);

        Navigation.NavigateTo("/");
    }
}
